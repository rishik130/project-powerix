<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contact Powerix – Energy Services Pvt. Ltd.</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green: #2eaa4a;
      --green-dark: #228a3a;
      --green-light: #e8f7ec;
      --text: #1a1a1a;
      --muted: #666;
      --border: #d0e8d8;
      --red: #d9534f;
      --white: #fff;
      --dark-bg: #0e1410;
      --dark-mid: #1a211c;
    }

    body {
      font-family: 'Barlow', sans-serif;
      color: var(--text);
      background: #f5f5f5;
    }

    /* ── NAVBAR ── */
    nav {
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 40px;
      height: 70px;
      box-shadow: 0 1px 4px rgba(0,0,0,.08);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .nav-logo svg {
      width: 46px;
      height: 46px;
    }

    .logo-text { line-height: 1.1; }
    .logo-text .brand {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--green);
      letter-spacing: .5px;
    }
    .logo-text .brand span { color: var(--text); }
    .logo-text .tagline {
      font-size: 9px;
      color: var(--muted);
      letter-spacing: .3px;
    }

    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .8px;
      text-transform: uppercase;
      color: var(--text);
      transition: color .2s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--green); }

    .nav-cta {
      background: var(--green);
      color: var(--white) !important;
      padding: 10px 22px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: background .2s;
    }
    .nav-cta:hover { background: var(--green-dark) !important; }

    /* ── MAIN LAYOUT ── */
    main {
      max-width: 1300px;
      margin: 50px auto;
      padding: 0 30px;
    }

    .contact-card {
      display: grid;
      grid-template-columns: 1fr 420px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 6px 32px rgba(0,0,0,.10);
      background: var(--white);
    }

    /* ── FORM SIDE ── */
    .form-side {
      padding: 52px 52px 48px;
    }

    .form-side h1 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 42px;
      font-weight: 700;
      color: var(--text);
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .form-side p {
      font-size: 14.5px;
      color: var(--muted);
      margin-bottom: 30px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }

    .field-wrap {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .field-wrap input,
    .field-wrap textarea {
      border: 1.5px solid var(--border);
      border-radius: 6px;
      padding: 14px 16px;
      font-size: 14px;
      font-family: 'Barlow', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color .2s;
      background: var(--white);
      width: 100%;
    }

    .field-wrap input::placeholder,
    .field-wrap textarea::placeholder { color: #aaa; }

    .field-wrap input:focus,
    .field-wrap textarea:focus { border-color: var(--green); }

    .field-wrap.error input { border-color: var(--red); }
    .field-wrap .err-msg {
      font-size: 12px;
      color: var(--red);
      font-weight: 500;
    }

    .field-full { margin-bottom: 16px; }

    .field-wrap textarea {
      resize: vertical;
      min-height: 130px;
    }

    .captcha-box {
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1.5px solid #ccc;
      border-radius: 6px;
      padding: 14px 16px;
      width: 260px;
      margin-bottom: 22px;
      background: #f9f9f9;
    }
    .captcha-box input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--green);
      flex-shrink: 0;
    }
    .captcha-label {
      font-size: 14px;
      color: #555;
      flex: 1;
    }
    .captcha-logo {
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 7px;
      color: #999;
      gap: 2px;
    }

    .btn-submit {
      width: 100%;
      background: var(--green);
      color: var(--white);
      border: none;
      border-radius: 6px;
      padding: 16px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      font-family: 'Barlow Condensed', sans-serif;
      transition: background .2s;
    }
    .btn-submit:hover { background: var(--green-dark); }

    /* ── INFO SIDE ── */
    .info-side {
      position: relative;
      background: linear-gradient(160deg, #1e6b35cc 0%, #0d3d1ecc 60%, #082710cc 100%),
                  url('https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=800&q=80') center/cover no-repeat;
      color: var(--white);
      padding: 48px 36px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .info-tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255,255,255,.65);
    }

    .info-side h2 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 34px;
      font-weight: 700;
      line-height: 1.15;
      margin-top: -16px;
    }

    .info-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .info-icon {
      width: 44px;
      height: 44px;
      background: var(--green);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .info-icon svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: white;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .info-label {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .info-value {
      font-size: 13.5px;
      color: rgba(255,255,255,.78);
      line-height: 1.5;
    }

    .social-row {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .social-label {
      font-size: 13px;
      color: rgba(255,255,255,.7);
      margin-right: 4px;
    }

    .social-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255,255,255,.15);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,.25);
      text-decoration: none;
      transition: background .2s;
    }
    .social-btn:hover { background: rgba(255,255,255,.28); }
    .social-btn svg {
      width: 16px;
      height: 16px;
      fill: white;
    }

    /* ── WHATSAPP WIDGET ── */
    .wa-widget {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 200;
    }

    .wa-bubble {
      width: 52px;
      height: 52px;
      background: var(--green);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0,0,0,.22);
      transition: transform .2s;
    }
    .wa-bubble:hover { transform: scale(1.07); }
    .wa-bubble svg { width: 28px; height: 28px; fill: white; }

    .wa-panel {
      position: absolute;
      bottom: 64px;
      right: 0;
      width: 300px;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,.18);
      display: none;
    }
    .wa-panel.open { display: block; }

    .wa-header {
      background: var(--green);
      color: white;
      padding: 18px 20px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .wa-header svg { width: 32px; height: 32px; fill: white; flex-shrink: 0; margin-top: 2px; }
    .wa-header h4 { font-size: 15px; font-weight: 700; }
    .wa-header p { font-size: 12.5px; opacity: .88; }
    .wa-header p strong { font-weight: 700; }

    .wa-body {
      background: var(--white);
      padding: 14px 16px;
    }

    .wa-reply-time {
      font-size: 12px;
      color: #888;
      margin-bottom: 12px;
    }

    .wa-contact {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-left: 3px solid var(--green);
      padding: 10px 12px;
      cursor: pointer;
      border-radius: 0 6px 6px 0;
      transition: background .2s;
    }
    .wa-contact:hover { background: var(--green-light); }

    .wa-contact-info { display: flex; align-items: center; gap: 10px; }
    .wa-contact-info svg { width: 34px; height: 34px; }

    .wa-name { font-size: 13.5px; font-weight: 700; }
    .wa-role { font-size: 11.5px; color: var(--muted); }
    .wa-contact > svg { width: 22px; height: 22px; fill: var(--green); }

    /* ── FOOTER ── */
    footer {
      background: var(--dark-bg);
      color: var(--white);
      position: relative;
    }

    .footer-main {
      max-width: 1300px;
      margin: 0 auto;
      padding: 64px 30px 40px;
      display: grid;
      grid-template-columns: 320px 1fr 1fr;
      gap: 60px;
    }

    .footer-brand .nav-logo { margin-bottom: 20px; }
    .footer-brand .brand { color: var(--green) !important; }
    .footer-brand .brand span { color: white !important; }
    .footer-brand .tagline { color: rgba(255,255,255,.5) !important; }

    .footer-brand p {
      font-size: 14px;
      color: rgba(255,255,255,.6);
      line-height: 1.7;
      max-width: 280px;
    }

    .footer-col h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 20px;
      color: white;
    }

    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }

    .footer-col ul a {
      text-decoration: none;
      font-size: 14px;
      color: rgba(255,255,255,.6);
      transition: color .2s;
    }
    .footer-col ul a:hover { color: var(--green); }

    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,.08);
      max-width: 1300px;
      margin: 0 auto;
      padding: 20px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(255,255,255,.4);
    }

    .footer-bottom a {
      color: rgba(255,255,255,.55);
      text-decoration: none;
    }
    .footer-bottom a:hover { color: var(--green); }

    .footer-bg {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(46,170,74,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(46,170,74,.04) 1px, transparent 1px);
      background-size: 44px 44px;
      pointer-events: none;
    }

    footer > * { position: relative; z-index: 1; }
  </style>
</head>
