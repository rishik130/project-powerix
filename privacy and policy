  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
  <style>
    :root {
      --nav-bg: #1c2e12;
      --hero-bg: #0f1f08;
      --green: #3db54a;
      --green-dark: #2a8a35;
      --cream: #f4f1eb;
      --cream-dark: #ebe7df;
      --white: #ffffff;
      --dark: #0f1f08;
      --text: #2a2a2a;
      --muted: #6b7a62;
      --border: #dde8d5;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text); font-size: 15px; line-height: 1.75; }

    nav {
      background: var(--nav-bg); display: flex; align-items: center; justify-content: space-between;
      padding: 0 48px; height: 60px; position: sticky; top: 0; z-index: 100;
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon { width: 36px; height: 36px; background: var(--green); border-radius: 8px; display: grid; place-items: center; }
    .nav-logo-icon svg { width: 20px; height: 20px; }
    .nav-logo-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.15rem; color: var(--white); }
    .nav-right { font-family: 'Syne', sans-serif; font-size: 0.72rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); }

    .hero {
      background: var(--hero-bg); padding: 72px 48px 64px;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at 80% 50%, rgba(61,181,74,0.07) 0%, transparent 65%);
    }
    .hero-inner { position: relative; z-index: 1; max-width: 860px; }
    .hero-label {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 3px;
      text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 16px;
    }
    .hero h1 {
      font-family: 'Syne', sans-serif; font-size: clamp(2.4rem,4vw,3.8rem);
      font-weight: 800; color: var(--white); line-height: 1.05; margin-bottom: 20px;
    }
    .hero h1 span { color: var(--green); }
    .hero p { font-size: 0.95rem; color: rgba(255,255,255,0.45); max-width: 540px; line-height: 1.7; margin-bottom: 28px; }
    .hero-meta { display: flex; gap: 28px; flex-wrap: wrap; }
    .hero-meta-item { font-size: 0.78rem; color: rgba(255,255,255,0.4); }
    .hero-meta-item strong { color: var(--green); font-weight: 600; }

    .page-wrap {
      max-width: 1200px; margin: 48px auto 64px;
      padding: 0 32px; display: grid;
      grid-template-columns: 240px 1fr; gap: 32px; align-items: start;
    }

    .toc {
      position: sticky; top: 80px; background: var(--white);
      border: 1px solid var(--border); border-radius: 10px; padding: 22px 18px;
      box-shadow: 0 2px 12px rgba(15,31,8,0.05);
    }
    .toc-title {
      font-family: 'Syne', sans-serif; font-size: 0.68rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 1.5px; color: var(--muted);
      margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border);
    }
    .toc ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }
    .toc ul li a {
      display: flex; align-items: center; gap: 8px; text-decoration: none;
      color: var(--muted); font-size: 0.8rem; padding: 6px 8px; border-radius: 6px;
      transition: background 0.15s, color 0.15s; line-height: 1.3;
    }
    .toc ul li a:hover { background: rgba(61,181,74,0.08); color: var(--green-dark); }
    .toc-num { font-family: 'Syne', sans-serif; font-size: 0.68rem; font-weight: 700; color: var(--green); min-width: 18px; }
    .toc-updated { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--border); font-size: 0.72rem; color: var(--muted); }
    .toc-updated strong { color: var(--text); display: block; margin-bottom: 2px; }

    .policy-content {
      background: var(--white); border: 1px solid var(--border); border-radius: 10px;
      padding: 40px 44px; box-shadow: 0 2px 12px rgba(15,31,8,0.05);
    }
    .policy-intro {
      background: linear-gradient(135deg,rgba(61,181,74,0.06),rgba(27,207,192,0.06));
      border: 1px solid rgba(61,181,74,0.15); border-left: 4px solid var(--green);
      border-radius: 0 8px 8px 0; padding: 18px 20px; margin-bottom: 36px;
      font-size: 0.88rem; color: var(--muted); line-height: 1.7;
    }
    .policy-intro strong { color: var(--dark); }
    .policy-section { margin-bottom: 40px; }
    .section-header {
      display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
      padding-bottom: 12px; border-bottom: 1px solid var(--border);
    }
    .section-num {
      display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0;
      background: var(--green); color: white; font-family: 'Syne', sans-serif;
      font-size: 0.82rem; font-weight: 700; border-radius: 6px;
    }
    .section-icon { font-size: 1.1rem; }
    .policy-section h2 { font-family: 'Syne', sans-serif; font-size: 1.15rem; font-weight: 700; color: var(--dark); }
    .policy-section p { font-size: 0.9rem; color: var(--text); margin-bottom: 12px; line-height: 1.75; }
    .policy-section p:last-child { margin-bottom: 0; }
    .policy-section ul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; padding: 0; }
    .policy-section ul li { display: flex; gap: 10px; font-size: 0.88rem; color: var(--text); line-height: 1.6; }
    .policy-section ul li::before { content: '▸'; color: var(--green); font-size: 0.75rem; flex-shrink: 0; margin-top: 3px; }
    .policy-section ol { list-style: none; counter-reset: ol-c; display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; padding: 0; }
    .policy-section ol li { counter-increment: ol-c; display: flex; gap: 10px; font-size: 0.88rem; color: var(--text); line-height: 1.6; }
    .policy-section ol li::before {
      content: counter(ol-c); background: rgba(61,181,74,0.1); color: var(--green-dark);
      font-family: 'Syne', sans-serif; font-size: 0.7rem; font-weight: 700;
      min-width: 20px; height: 20px; display: grid; place-items: center; border-radius: 4px; flex-shrink: 0; margin-top: 2px;
    }
    .policy-section strong { color: var(--dark); font-weight: 600; }
    .info-box {
      background: rgba(61,181,74,0.06); border: 1px solid rgba(61,181,74,0.15);
      border-radius: 8px; padding: 14px 18px; margin: 14px 0;
