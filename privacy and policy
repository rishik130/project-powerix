    .policy-table tbody tr { border-bottom: 1px solid var(--border); }
    .policy-table tbody tr:hover { background: rgba(61,181,74,0.04); }
    .policy-table tbody td { padding: 10px 14px; color: var(--text); vertical-align: top; }
    .policy-table tbody td:first-child { font-weight: 500; color: var(--dark); }
    .contact-card {
      background: var(--hero-bg); border-radius: 10px; padding: 24px; color: white;
      margin-top: 16px; border: 1px solid rgba(61,181,74,0.2);
    }
    .contact-card h4 { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; color: var(--green); margin-bottom: 14px; }
    .contact-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; font-size: 0.85rem; color: rgba(255,255,255,0.65); }
    .contact-row svg { flex-shrink: 0; margin-top: 2px; }
    .contact-row a { color: var(--green); text-decoration: none; }
    .section-divider { border: none; border-top: 1px solid var(--border); margin: 0 0 40px; }

    footer { background: var(--dark); color: rgba(255,255,255,0.3); text-align: center; padding: 20px; font-size: 0.75rem; }
    footer span { color: var(--green); }

    .wa-float {
      position: fixed; bottom: 28px; right: 28px; z-index: 999;
      width: 54px; height: 54px; background: #25D366; border-radius: 50%;
      display: grid; place-items: center; text-decoration: none; transition: transform 0.2s;
      box-shadow: 0 4px 20px rgba(37,211,102,0.45);
    }
    .wa-float:hover { transform: scale(1.1); }

    @media (max-width: 860px) {
      .page-wrap { grid-template-columns: 1fr; }
      .toc { position: static; }
      .policy-content { padding: 24px 20px; }
      .hero { padding: 48px 20px; }
      nav { padding: 0 20px; }
    }
  </style>
</head>
