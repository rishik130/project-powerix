    .phone-row { display: flex; align-items: center; justify-content: center; gap: 10px; font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; margin-bottom: 14px; }
    .phone-circle { width: 34px; height: 34px; background: rgba(255,255,255,0.2); border-radius: 50%; display: grid; place-items: center; }
    .btn-contact {
