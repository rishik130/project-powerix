    .form-box h3 { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; text-align: center; margin-bottom: 6px; color: var(--dark); }
    .form-box p { font-size: 0.78rem; color: var(--muted); text-align: center; margin-bottom: 16px; }
    .form-box input, .form-box textarea {
      width: 100%; background: rgba(61,181,74,0.05); border: 1.5px solid var(--border);
      border-radius: 6px; padding: 10px 14px; font-family: 'DM Sans', sans-serif;
      font-size: 0.84rem; color: var(--text); margin-bottom: 10px; outline: none;
      resize: vertical; transition: border-color 0.2s;
    }
    .form-box input:focus, .form-box textarea:focus { border-color: var(--green); }
    .form-box input::placeholder, .form-box textarea::placeholder { color: #bbb; }
    .form-box textarea { min-height: 80px; }
    .captcha-row {
      display: flex; align-items: center; gap: 10px;
      background: var(--cream); border: 1.5px solid var(--border); border-radius: 6px;
      padding: 10px 14px; margin-bottom: 14px; font-size: 0.84rem;
    }
    .captcha-row input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--green); }
    .btn-quote {
      width: 100%; background: var(--green); color: white; border: none; border-radius: 6px;
