    .nav-cta { background: var(--green) !important; color: white !important; padding: 8px 18px; border-radius: 5px; }

    .hero {
      background: var(--hero-bg); padding: 72px 48px 64px;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at 80% 50%, rgba(61,181,74,0.07) 0%, transparent 65%);
    }
    .hero-inner { position: relative; z-index: 1; max-width: 700px; }
    .hero-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 16px; }
    .hero h1 { font-family: 'Syne', sans-serif; font-size: clamp(2.4rem,4vw,3.8rem); font-weight: 800; color: var(--white); line-height: 1.05; margin-bottom: 16px; }
    .hero h1 span { color: var(--green); }
    .hero p { font-size: 0.95rem; color: rgba(255,255,255,0.45); max-width: 480px; line-height: 1.7; }

    .page-wrap {
      max-width: 1280px; margin: 48px auto 64px; padding: 0 32px;
      display: grid; grid-template-columns: 1fr 320px; gap: 28px; align-items: start;
    }

    .services { display: flex; flex-direction: column; gap: 22px; }

    /* Full-width card */
    .service-card {
      background: var(--white); border-radius: 12px; border: 1px solid var(--border);
      display: flex; gap: 0; overflow: hidden;
      box-shadow: 0 2px 14px rgba(15,31,8,0.06);
      transition: box-shadow 0.25s, transform 0.25s;
    }
    .service-card:hover { box-shadow: 0 8px 28px rgba(61,181,74,0.1); transform: translateY(-2px); }
    .service-img {
      width: 220px; min-width: 220px; object-fit: cover; display: block;
    }
    .service-body { padding: 28px 26px; display: flex; flex-direction: column; justify-content: flex-start; flex: 1; }

    /* Two-col grid */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .two-col-card {
      background: var(--white); border-radius: 12px; border: 1px solid var(--border);
      overflow: hidden; box-shadow: 0 2px 14px rgba(15,31,8,0.06);
      transition: box-shadow 0.25s, transform 0.25s; display: flex; flex-direction: column;
    }
    .two-col-card:hover { box-shadow: 0 8px 28px rgba(61,181,74,0.1); transform: translateY(-2px); }
    .two-col-card .service-img { width: 100%; min-width: unset; height: 180px; }
    .two-col-card .service-body { padding: 22px 20px; }

    .card-tag {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(61,181,74,0.1); color: var(--green-dark);
      font-size: 0.65rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
      padding: 4px 10px; border-radius: 20px; border: 1px solid rgba(61,181,74,0.2);
      margin-bottom: 12px; width: fit-content;
    }
    .card-title { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--dark); margin-bottom: 14px; }
    .two-col-card .card-title { font-size: 1rem; }
    .card-list { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .card-list li { display: flex; gap: 10px; font-size: 0.82rem; color: var(--text); line-height: 1.5; }
    .card-list li::before { content: ''; width: 20px; height: 20px; border-radius: 50%; background: var(--green); display: grid; place-items: center; flex-shrink: 0; margin-top: 1px; }
    .card-list li::before { content: '✓'; color: white; font-size: 0.65rem; font-weight: 700; }
    .card-list li strong { color: var(--dark); font-weight: 600; }
    .btn-enquire {
      display: inline-flex; align-items: center; gap: 8px;
      border: 2px solid rgba(200,180,80,0.6); color: var(--dark);
      background: transparent; font-family: 'Syne', sans-serif;
      font-size: 0.75rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
      padding: 9px 18px; border-radius: 6px; cursor: pointer; text-decoration: none;
      transition: all 0.2s; width: fit-content; margin-top: auto;
