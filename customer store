    /* WHY */
    .why-section { background: var(--cream-dark); padding: 56px 48px; border-top: 1px solid var(--border); }
    .why-inner { max-width: 1280px; margin: 0 auto; }
    .why-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--green); display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .why-label::before { content: ''; width: 20px; height: 2px; background: var(--green); }
    .why-inner h2 { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; color: var(--dark); margin-bottom: 32px; }
    .why-cards { display: flex; gap: 16px; flex-wrap: wrap; }
    .why-card {
