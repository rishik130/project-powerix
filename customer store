    }
    .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
    .nav-logo-icon { width: 36px; height: 36px; background: var(--green); border-radius: 8px; display: grid; place-items: center; }
    .nav-logo-icon svg { width: 20px; height: 20px; }
    .nav-logo-wrap { display: flex; flex-direction: column; line-height: 1; }
    .nav-logo-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.15rem; color: var(--white); }
    .nav-logo-sub { font-size: 0.6rem; color: rgba(255,255,255,0.35); }
    .nav-links { display: flex; gap: 36px; list-style: none; align-items: center; }
    .nav-links a { font-family: 'Syne', sans-serif; font-size: 0.72rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
