  <style>
    :root {
      --nav-bg: #1c2e12;
      --hero-bg: #0f1f08;
      --green: #3db54a;
      --green-dark: #2a8a35;
      --cream: #f4f1eb;
      --cream-dark: #ebe7df;
      --white: #ffffff;
      --dark: #0f1f08;
      --text: #2a2a2a;
      --muted: #6b7a62;
      --border: #dde8d5;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text); }

    nav {
